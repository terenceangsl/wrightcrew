{
  "_comment": "Copy to cadre.config.json. Paths are relative to repo_root. The runner list is the command the driver runs per lane; {tools} {name} {launch} {log} {timeout} {model} are filled in.",
  "repo_root": ".",
  "runtime_dir": ".cadre/run",
  "deadline": "2026-10-26T06:00:00",
  "stop_files": ["STOP", "USER_BACK"],
  "guarded_paths": ["src", "dist"],
  "health_url": "http://127.0.0.1:8080/v1/models",
  "model": "local-model-name",
  "runner": ["python", "tools/run_lane.py", "local", "{model}", "{tools}", "{name}", "{launch}", "{log}", "{timeout}"],
  "lane_timeout_s": 14400,
  "pause_between_lanes_s": 60,
  "max_builder_fail_streak": 2,
  "roles": {
    "builder": {"tools": "read,edit,write,bash"},
    "docs":    {"tools": "read,write,bash"},
    "review":  {"tools": "read,write,bash"}
  },
  "review_after_builder": true,
  "review_template": "templates/review_prompt.md",
  "refill_prompt": "templates/refill_prompt.md",
  "refill_autoqueue": false
}
